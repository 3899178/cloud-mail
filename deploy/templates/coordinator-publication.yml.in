name: Publish accepted Cloud Mail runtime
on:
  workflow_dispatch:
permissions:
  contents: read
env:
  CLOUD_MAIL_APPLICATION_SOURCE: __APPLICATION_SOURCE_SHA__
concurrency:
  group: cloud-mail-public-image-release
  cancel-in-progress: false
jobs:
  publish:
    if: github.repository == '3899178/cloud-mail-build' && github.actor == '3899178' && github.ref == 'refs/heads/main'
    runs-on: ubuntu-24.04
    timeout-minutes: 40
    environment: public-image-release
    permissions:
      contents: read
      packages: write
    outputs:
      source: ${{ steps.publish.outputs.source }}
      digest: ${{ steps.publish.outputs.digest }}
      testedImageID: ${{ steps.publish.outputs.testedImageID }}
    steps:
      - name: Check out reviewed application source
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          repository: 3899178/cloud-mail
          ref: ${{ env.CLOUD_MAIL_APPLICATION_SOURCE }}
          persist-credentials: false
      - name: Accept the exact runtime image with complete Linux gates
        run: node deploy/publication.mjs accept
      - name: Publish that accepted image without rebuilding
        id: publish
        env:
          GHCR_TOKEN: ${{ github.token }}
        run: node deploy/publication.mjs publish
  verify-public:
    needs: publish
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    permissions:
      contents: read
    steps:
      - name: Check out the same application verifier
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          repository: 3899178/cloud-mail
          ref: ${{ env.CLOUD_MAIL_APPLICATION_SOURCE }}
          persist-credentials: false
      - name: Verify anonymous manifest config and immutable pull
        env:
          PUBLIC_SOURCE: ${{ needs.publish.outputs.source }}
          PUBLIC_DIGEST: ${{ needs.publish.outputs.digest }}
          PUBLIC_TESTED_IMAGE_ID: ${{ needs.publish.outputs.testedImageID }}
        run: node deploy/publication.mjs verify
